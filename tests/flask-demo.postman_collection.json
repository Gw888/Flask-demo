      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:5000/api/users",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "5000",
          "path": ["api", "users"]
        }
