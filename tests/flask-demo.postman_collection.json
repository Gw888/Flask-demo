          "mode": "raw",
          "raw": "{\n    \"username\": \"newuser\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"newpassword\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:5000/api/users/1",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "5000",
          "path": ["api", "users", "1"]
        }
